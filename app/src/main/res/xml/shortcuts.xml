<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcut: long-press the app icon → "Search". The intent
     action routes through MainActivity to PendingSearch; targetPackage is the
     applicationId (not the code namespace) — the two differ in this app. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open-search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="com.lumen.app.action.OPEN_SEARCH"
            android:targetPackage="io.github.royalgillz.lumen"
            android:targetClass="com.lumen.app.MainActivity" />
    </shortcut>
</shortcuts>
