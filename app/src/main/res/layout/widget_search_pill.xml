<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-compatible views only (LinearLayout/ImageView/TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_pill_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_search_pill_bg"
    android:contentDescription="@string/widget_search_label"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_search_text"
        android:textColor="@color/lumen_warm_white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
